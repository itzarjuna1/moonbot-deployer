# Uppermoon Music Bot - Environment Variables
# Copy this file to .env and fill in your values

# ===========================================
# MAIN BOT CREDENTIALS (from @BotFather)
# ===========================================
API_ID=your_api_id
API_HASH=your_api_hash
BOT_TOKEN=your_bot_token

# ===========================================
# ASSISTANT ACCOUNT (for Voice Chat streaming)
# Get credentials from my.telegram.org
# Generate string session using Pyrogram
# ===========================================
ASSISTANT_API_ID=your_assistant_api_id
ASSISTANT_API_HASH=your_assistant_api_hash
ASSISTANT_STRING_SESSION=your_string_session

# ===========================================
# OWNER CONFIGURATION
# ===========================================
OWNER_ID=your_telegram_user_id
SUDO_USERS=user_id_1 user_id_2

# ===========================================
# BOT SETTINGS
# ===========================================
BOT_NAME=Uppermoon Music
BOT_USERNAME=your_bot_username
SUPPORT_GROUP=https://t.me/snowy_hometown

# ===========================================
# MUSIC SETTINGS
# ===========================================
DURATION_LIMIT=60
SONG_DOWNLOAD_DURATION=10
AUDIO_BITRATE=128k
VIDEO_QUALITY=720p

# ===========================================
# DIRECTORIES
# ===========================================
CACHE_DIR=./cache
TEMP_DIR=./temp

# ===========================================
# NOTIFICATIONS
# ===========================================
LOG_CHANNEL=your_log_channel_id
NOTIFY_CHAT_ID=your_notify_chat_id
WEBSITE_URL=https://your-website.com
